FROM itzcrazykns1337/vane@sha256:0b61bf0d4470e9f2a9c71f794b72fab6e5a612177172770684c158a461f6896e AS builder
WORKDIR /home/vane
COPY . .
RUN node --test upstream.test.cjs search_provider.test.cjs evidence.test.cjs
RUN rm -rf .next public/_next && node node_modules/next/dist/bin/next build --webpack

FROM itzcrazykns1337/vane@sha256:0b61bf0d4470e9f2a9c71f794b72fab6e5a612177172770684c158a461f6896e
WORKDIR /home/vane
RUN rm -rf .next
COPY --from=builder /home/vane/.next/standalone ./
COPY --from=builder /home/vane/.next/static ./public/_next/static
